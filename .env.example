# =============================================================================
# SOC Agent - Configuracion de Entorno
# =============================================================================
# Copia este archivo como .env y completa con tus valores:
#   cp .env.example .env
#
# Las APIs marcadas con [GRATUITA] tienen tier gratuito disponible.
# Las marcadas con [SIN KEY] no requieren API key.
# =============================================================================


# =============================================================================
# FLASK
# =============================================================================
FLASK_APP=wsgi.py
FLASK_ENV=development
# FLASK_ENV=production
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"

# Hosts aceptados en la cabecera Host (separados por coma). Cualquier otro recibe 400
# (defensa contra Host Header Poisoning). ".dominio.com" incluye sus subdominios.
# En produccion detras de un proxy con dominio propio es OBLIGATORIO definirlo.
ALLOWED_HOSTS=127.0.0.1,localhost


# =============================================================================
# BASE DE DATOS (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://soc_admin:tu_password@localhost:5432/soc_agent
# PostgreSQL es OBLIGATORIO: el esquema usa JSONB, UUID y la extension pg_trgm.
# SQLite NO funciona (los modelos fallan al crear las tablas).
# En Windows con Postgres en espanol anade ?client_encoding=utf8 a la URL.


# =============================================================================
# REDIS (Opcional - para cache y rate limiting)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0


# =============================================================================
# THREAT INTELLIGENCE APIs
# =============================================================================

# --- Reputacion ---

# VirusTotal [GRATUITA - 500 req/dia]
# https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# AbuseIPDB [GRATUITA - 1000 req/dia]
# https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# GreyNoise [GRATUITA - Community]
# https://viz.greynoise.io/signup
GREYNOISE_API_KEY=

# Pulsedive [GRATUITA - limitada]
# https://pulsedive.com/register
PULSEDIVE_API_KEY=

# --- Infraestructura ---

# Shodan [GRATUITA - limitada]
# https://account.shodan.io/register
SHODAN_API_KEY=

# Shodan InternetDB [SIN KEY]
# No requiere configuracion

# Criminal IP [$]
# https://www.criminalip.io/
CRIMINAL_IP_API_KEY=

# SecurityTrails [GRATUITA - 50 req/mes]
# https://securitytrails.com/app/signup
SECURITYTRAILS_API_KEY=

# --- Malware ---

# ThreatFox [SIN KEY]
# https://threatfox.abuse.ch/

# MalwareBazaar [SIN KEY]
# https://bazaar.abuse.ch/

# Hybrid Analysis [GRATUITA]
# https://www.hybrid-analysis.com/apikeys/info
HYBRID_ANALYSIS_API_KEY=

# --- URLs ---

# URLhaus [SIN KEY]
# https://urlhaus.abuse.ch/

# URLScan [GRATUITA - limitada]
# https://urlscan.io/user/signup
URLSCAN_API_KEY=

# Google Safe Browsing [GRATUITA]
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFEBROWSING_API_KEY=

# --- Inteligencia ---

# AlienVault OTX [GRATUITA - ilimitada]
# https://otx.alienvault.com/api
OTX_API_KEY=

# IP-API [SIN KEY - Geolocalizacion]
# https://ip-api.com/


# =============================================================================
# LLM PROVIDERS (al menos 1 requerido para analisis con IA)
# =============================================================================

# Proveedor por defecto: xai, openai, deepseek, gemini, kimi
DEFAULT_LLM_PROVIDER=deepseek

# xAI (Grok)
# https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-beta

# OpenAI (GPT-4)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek [PAGO, muy económico]
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Kimi (Moonshot) [PAGO] - endpoint internacional api.moonshot.ai (el .cn no acepta estas keys)
# https://platform.moonshot.ai/console/api-keys
KIMI_API_KEY=


# =============================================================================
# SEGURIDAD
# =============================================================================
# Rate limiting
# RATELIMIT_DEFAULT=100/hour
# RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Session
# SESSION_COOKIE_SECURE=true   # Activar solo con HTTPS
# PREFERRED_URL_SCHEME=https


# =============================================================================
# MONITOREO (Opcional)
# =============================================================================
# Sentry - Error tracking
# https://sentry.io/
# SENTRY_DSN=

# Logging level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# NVD (CVEs). OPCIONAL pero recomendada: sin clave NVD admite 5 peticiones cada 30 s y el servicio `feeds` (descargas periódicas)
# y el análisis de CVE de los usuarios COMPARTEN ese límite (429/403 => la ejecución del feed o el análisis falla).
# Con clave son 50 cada 30 s. Se pide gratis en https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Política de salida (WP4): dominios PROPIOS que deben tratarse como internos y no enviarse a APIs de terceros, separados por coma
# (p. ej. intranet.empresa.com,corp.empresa.com). Casan por límite de etiqueta. Los sufijos reservados (.local .lan .internal .corp...)
# ya están protegidos. Un dominio interno con nombre PÚBLICO no se detecta solo: declararlo aquí.
EGRESS_INTERNAL_DOMAINS=

# Telegram (WP7): AVISOS salientes de los feeds (CVE que afectan a tu stack). Sin token y al menos un chat NO se hace nada.
# 1) Crea un bot con @BotFather y pega aquí su token (es un SECRETO: da control total del bot; nunca lo subas a git).
# 2) Escribe /start a tu bot desde tu chat y averigua tu chat id (p. ej. con @userinfobot). Los grupos tienen id negativo.
TELEGRAM_BOT_TOKEN=
# Chats PERMITIDOS que reciben los avisos, separados por coma. Solo se envía a esta lista.
TELEGRAM_ALERT_CHAT_IDS=
# Desde qué riesgo avisar: ALTO (por defecto; incluye siempre los de KEV), MEDIO o CRÍTICO.
TELEGRAM_MIN_RISK=ALTO
# Al activarlo no se avisa de CVE más antiguos que estos días.
TELEGRAM_BACKLOG_DAYS=3
# URL pública de SOC Agent (opcional): añade un enlace 'Analizar' en cada aviso. Sin barra final.
APP_BASE_URL=

# Auditoria con cadena criptografica (WP1): clave HMAC que sella cada evento. OBLIGATORIA en produccion (>=32 caracteres).
# Guardala FUERA de la BD y de sus backups: quien tenga solo la BD no puede falsificar la cadena sin ella.
# Generala con: python -c "import secrets; print(secrets.token_hex(32))"   Verifica con: flask audit verify
AUDIT_CHAIN_KEY=
# Rotacion: claves anteriores (coma) para seguir verificando lo ya sellado. NO la borres al rotar.
AUDIT_CHAIN_PREVIOUS_KEYS=
# Solo si la clave se anadio tarde y hay historico sin clave: true
AUDIT_CHAIN_ACCEPT_UNKEYED=

# --- Docker: contrasenas de BD (OBLIGATORIAS, sin valor por defecto) ---
# OJO: Compose interpola estas variables desde el entorno del host o desde un `.env` junto a docker-compose.yml, NO desde `.env.docker`
# (ese archivo solo llega al contenedor). Ponlas en `.env` o usa `docker compose --env-file .env.docker ...`.
# POSTGRES_PASSWORD: administrador de la BD (soc_admin, superusuario). Solo lo usan las migraciones al arrancar `app`.
POSTGRES_PASSWORD=
# APP_DB_PASSWORD: rol de la app (>=16 caracteres), SIN privilegios: no puede apagar el trigger de auditoria ni borrar auditoria.
APP_DB_PASSWORD=
APP_DB_USER=soc_app

# Clave de la cadena PERDIDA: key_id (8 hex) de la clave que ya no tienes. Ver docs/runbooks/RUNBOOK-AUDIT-CHAIN.md
AUDIT_CHAIN_LOST_KEY_IDS=
